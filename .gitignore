# Terraform working files (never commit these)
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
tfplan
plan.txt
drift.txt
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Bootstrap variables contain your personal values
bootstrap/terraform.tfvars

# Lambda build output
modules/lambda_app/build/

# Python
__pycache__/
*.pyc

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# NOTE: .terraform.lock.hcl IS committed on purpose (pins provider versions)
